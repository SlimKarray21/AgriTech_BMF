# ========================================
# Piston Control System - Environment Variables
# ========================================
# 
# SETUP INSTRUCTIONS:
# 1. DO NOT edit this file directly
# 2. Run: ./generate-secrets.sh
#    (This creates .env with secure random secrets)
# 
# OR manually:
# 1. Copy: cp .env.example .env
# 2. Generate secrets:
#    openssl rand -base64 64 | tr -d "=+/"
# 3. Replace values below
#
# ========================================

# PostgreSQL Database
POSTGRES_PASSWORD=your_secure_password_here

# JWT Authentication (minimum 32 characters required)
JWT_SECRET=your_jwt_secret_minimum_32_characters

# Redis Cache
REDIS_PASSWORD=your_redis_password

# SMTP (Email verification - server side only)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your_email_account
SMTP_PASSWORD=your_email_app_password
SMTP_FROM=noreply@agritech.local

# OTP verification policy
OTP_LENGTH=6
OTP_EXPIRY_MINUTES=10
OTP_MAX_VERIFY_ATTEMPTS=5
OTP_MAX_RESEND_PER_HOUR=3

# Build metadata
BUILD_DATE=2024-01-01T00:00:00Z
VCS_REF=main
