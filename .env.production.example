# ============================================================
# PRODUCTION .env — Azure VM
# 1. Copier ce fichier : cp .env.production.example .env
# 2. Remplacer TOUTES les valeurs par des vraies valeurs
# 3. Ne jamais committer ce fichier sur git
# ============================================================

# --- Base de données ---
POSTGRES_PASSWORD=CHANGER_MOI_mot_de_passe_fort_20_chars

# --- JWT (générer avec: python -c "import secrets; print(secrets.token_urlsafe(48))")
JWT_SECRET=CHANGER_MOI_cle_jwt_tres_longue_et_aleatoire
JWT_ISSUER=agritech-prod
JWT_AUDIENCE=agritech-app

# --- Sessions
SESSION_ENCRYPT_KEY=CHANGER_MOI_32_hex_chars
SESSION_SIGN_KEY=CHANGER_MOI_32_hex_chars

# --- Redis
REDIS_PASSWORD=CHANGER_MOI_mot_de_passe_redis

# --- URL du serveur (ton domaine Azure ou IP publique)
SERVER_BASE_URL=https://TON_DOMAINE_OU_IP/
ADMIN_API_BASE_URL=https://TON_DOMAINE_OU_IP

# --- SMTP (Gmail)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=contact.agritech26@gmail.com
SMTP_PASSWORD=TON_APP_PASSWORD_GMAIL
SMTP_FROM=contact.agritech26@gmail.com

# --- Build info
BUILD_DATE=
VCS_REF=

# --- Port admin (accessible via nginx en prod, garder 8082 en local)
ADMIN_PORT=8082
